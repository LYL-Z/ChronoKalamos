# =========================
# Browser-visible variables
# =========================
# These values are safe to expose only because Supabase RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Turnstile site key is public; the matching secret below is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# =========================
# Server-only variables
# =========================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# Emergency server-side kill switch. Set false before a provider incident or
# cost anomaly; no new model calls are admitted and no game state is committed.
AI_TURNS_ENABLED=true
# Server-side fail-closed budgets. Every provider attempt, including one retry,
# consumes one admission. Invalid values fall back to these safe defaults.
AI_DAILY_USER_LIMIT=40
AI_DAILY_GLOBAL_LIMIT=500
# Used only to pseudonymize actor UUIDs in structured security logs. Do not
# reuse an API key, auth token, phone audit salt, or user-facing value.
SECURITY_AUDIT_SALT=
# Public release identifier such as a Git commit SHA; never put secrets here.
APP_RELEASE=

# =========================
# Deferred phone track (not part of the active free TOTP path)
# =========================
# Keep these values at their safe defaults. TOTP uses Supabase Auth directly
# and requires no Twilio, Turnstile, or additional browser variable.
PHONE_AUTH_PROVIDER=mock
PHONE_AUTH_ENABLED=false
PHONE_AUTH_POLICY_VERIFIED=false

# Never prefix any of these with NEXT_PUBLIC_. They are server-only secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# TURNSTILE_SITE_KEY may equal the public site key, but remains server config
# for readiness validation. TURNSTILE_SECRET must never enter a client bundle.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_EXPECTED_HOSTNAME=chronokalamos.com

# At most one call per phone/60 seconds and ten calls per IP/day. The daily
# Twilio circuit breaker defaults to 20 and counts admissions before the
# external call, so an exhausted budget fails closed.
PHONE_AUTH_DAILY_LIMIT=20
PHONE_AUTH_AUDIT_SALT=

# =========================
# Live test project only
# =========================
# Keep real values in the ignored .env.test file.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
SUPABASE_TEST_UPGRADE_EMAIL=
