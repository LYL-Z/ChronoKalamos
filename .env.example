# Public browser configuration. RLS is the security boundary.
# Never add SUPABASE_SERVICE_ROLE_KEY or another server secret here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public Turnstile site key. The matching secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server runtime only. The publishable key is still RLS-scoped; never place
# DEEPSEEK_API_KEY or a Supabase service-role key in a browser-visible variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Phase 7 preparation track: China mainland + Twilio Verify + Cloudflare Turnstile.
# Keep every value below server-only. Leave PHONE_AUTH_ENABLED=false until all
# provider, delivery, recovery, and sandbox evidence gates are verified.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
PHONE_AUTH_ENABLED=false
PHONE_AUTH_POLICY_VERIFIED=false

# Live Phase 3 integration tests. Keep real values in the ignored .env.test file.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
# Optional server-only key for the phase 5 commit RPC test.
SUPABASE_TEST_SECRET_KEY=
# Optional controlled inbox for the email-upgrade initiation test.
SUPABASE_TEST_UPGRADE_EMAIL=
