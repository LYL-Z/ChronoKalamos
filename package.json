{
  "name": "chronokalamos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run content:validate && npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:contracts",
    "test:unit": "vitest run",
    "test:contracts": "node --test tests/rendered-html.test.mjs tests/supabase-contract.test.mjs tests/phase5-rendered-contract.test.mjs tests/phase6-hardening.test.mjs tests/phase7-readiness.test.mjs tests/phase7-provider-contract.test.mjs tests/phase9-onboarding.test.mjs",
    "test:supabase:live": "node --env-file-if-exists=.env.test --test tests/supabase-live.test.mjs",
    "test:deepseek:production": "node --env-file-if-exists=.env.test scripts/eval-deepseek-production.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .sites",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "content:validate": "node scripts/validate-phase4-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "^2.109.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
